<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Calculated Calorie Target - Vitality</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&amp;family=Roboto+Flex:wght@400;600&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface": "#f8faf9",
                        "surface-container-highest": "#e1e3e2",
                        "on-secondary-container": "#327053",
                        "on-tertiary-fixed": "#000866",
                        "primary": "#0f5238",
                        "secondary": "#2b694d",
                        "on-primary-container": "#a8e7c5",
                        "on-primary": "#ffffff",
                        "primary-fixed-dim": "#95d4b3",
                        "tertiary-fixed-dim": "#bdc2ff",
                        "on-background": "#191c1c",
                        "secondary-fixed-dim": "#94d4b1",
                        "on-secondary-fixed-variant": "#0c5136",
                        "outline-variant": "#bfc9c1",
                        "surface-container-low": "#f2f4f3",
                        "primary-fixed": "#b1f0ce",
                        "surface-bright": "#f8faf9",
                        "primary-container": "#2d6a4f",
                        "secondary-container": "#b0f1cc",
                        "surface-variant": "#e1e3e2",
                        "surface-container-high": "#e6e9e8",
                        "on-tertiary": "#ffffff",
                        "on-tertiary-container": "#d5d7ff",
                        "on-secondary-fixed": "#002113",
                        "on-primary-fixed-variant": "#0e5138",
                        "surface-container": "#eceeed",
                        "on-error": "#ffffff",
                        "on-primary-fixed": "#002114",
                        "surface-container-lowest": "#ffffff",
                        "inverse-primary": "#95d4b3",
                        "on-surface": "#191c1c",
                        "surface-tint": "#2c694e",
                        "outline": "#707973",
                        "on-error-container": "#93000a",
                        "on-secondary": "#ffffff",
                        "tertiary": "#313c9f",
                        "error": "#ba1a1a",
                        "tertiary-container": "#4a55b9",
                        "inverse-on-surface": "#eff1f0",
                        "secondary-fixed": "#b0f1cc",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#303b9f",
                        "surface-dim": "#d8dada",
                        "on-surface-variant": "#404943",
                        "background": "#f8faf9",
                        "tertiary-fixed": "#dfe0ff",
                        "inverse-surface": "#2e3131"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container-padding": "20px",
                        "unit": "4px",
                        "gutter": "16px",
                        "margin-tablet": "24px",
                        "stack-md": "16px",
                        "margin-mobile": "16px",
                        "stack-sm": "8px",
                        "stack-lg": "32px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Roboto Flex"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "title-lg": ["Inter"],
                        "headline-lg-mobile": ["Roboto Flex"],
                        "label-sm": ["Inter"],
                        "display-lg": ["Roboto Flex"],
                        "label-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "600" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "letterSpacing": "0.5px", "fontWeight": "400" }],
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "title-lg": ["22px", { "lineHeight": "28px", "fontWeight": "500" }],
                        "headline-lg-mobile": ["28px", { "lineHeight": "36px", "fontWeight": "600" }],
                        "label-sm": ["11px", { "lineHeight": "16px", "letterSpacing": "0.5px", "fontWeight": "500" }],
                        "display-lg": ["57px", { "lineHeight": "64px", "letterSpacing": "-0.25px", "fontWeight": "400" }],
                        "label-lg": ["14px", { "lineHeight": "20px", "letterSpacing": "0.1px", "fontWeight": "500" }]
                    }
                }
            }
        }
    </script>
<style>
        .glass-ring {
            background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.1) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.3);
            box-shadow: 0 8px 32px 0 rgba(15, 82, 56, 0.05);
        }
        
        @keyframes pulse-soft {
            0% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.02); opacity: 1; }
            100% { transform: scale(1); opacity: 0.8; }
        }
        .ai-pulse {
            animation: pulse-soft 4s ease-in-out infinite;
        }
    </style>
</head>
<body class="bg-background text-on-background antialiased min-h-screen flex flex-col items-center justify-center relative overflow-hidden">
<!-- Abstract Ambient Background -->
<div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
<div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-primary-container opacity-[0.03] rounded-full blur-[120px] ai-pulse"></div>
<div class="absolute bottom-[-10%] right-[-10%] w-[60%] h-[60%] bg-tertiary-container opacity-[0.04] rounded-full blur-[150px] ai-pulse" style="animation-delay: 2s;"></div>
</div>
<!-- Main Content Canvas -->
<main class="w-full max-w-[480px] px-margin-mobile md:px-margin-tablet py-stack-lg z-10 flex flex-col flex-grow justify-between">
<!-- Header / Progress -->
<header class="w-full flex flex-col items-center gap-stack-sm mt-8">
<div class="w-full flex items-center justify-between mb-4">
<button class="w-10 h-10 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-surface-variant/50 transition-colors">
<span class="material-symbols-outlined">arrow_back</span>
</button>
<div class="flex items-center gap-2">
<span class="font-label-sm text-label-sm text-primary uppercase tracking-wider">Step 6/6</span>
</div>
<div class="w-10 h-10"></div> <!-- Balancer -->
</div>
<div class="w-full h-1 bg-surface-variant rounded-full overflow-hidden mb-6">
<div class="h-full bg-primary rounded-full w-full"></div>
</div>
<div class="text-center">
<div class="inline-flex items-center justify-center gap-2 px-3 py-1 rounded-full bg-tertiary-container/20 border border-tertiary/10 mb-3">
<span class="material-symbols-outlined text-tertiary text-sm" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
<span class="font-label-sm text-label-sm text-tertiary">AI Calibrated</span>
</div>
<h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-background mb-2">Your AI-Generated Plan</h1>
<p class="font-body-md text-body-md text-on-surface-variant max-w-sm mx-auto">Based on your activity level and goal to build lean muscle, our AI has calibrated your optimal daily targets.</p>
</div>
</header>
<!-- Central Display -->
<section class="flex-grow flex flex-col items-center justify-center py-stack-lg relative w-full">
<!-- Glass Ring Container -->
<div class="relative w-64 h-64 md:w-80 md:h-80 rounded-full glass-ring flex flex-col items-center justify-center p-6 mx-auto">
<!-- Decorative Progress SVG Ring -->
<svg class="absolute inset-0 w-full h-full transform -rotate-90 pointer-events-none" viewBox="0 0 100 100">
<circle class="text-surface-variant opacity-30" cx="50" cy="50" fill="none" r="46" stroke="currentColor" stroke-width="2"></circle>
<circle class="text-primary" cx="50" cy="50" fill="none" r="46" stroke="currentColor" stroke-dasharray="289" stroke-dashoffset="0" stroke-linecap="round" stroke-width="4"></circle>
</svg>
<div class="text-center relative z-10 flex flex-col items-center">
<span class="font-display-lg text-display-lg text-primary tracking-tight leading-none mb-1">2,150</span>
<span class="font-title-lg text-title-lg text-on-surface-variant">kcal / day</span>
</div>
<!-- Macro Breakdown mini-pills -->
<div class="absolute bottom-6 left-0 w-full flex justify-center gap-3 px-4">
<div class="flex items-center gap-1 bg-surface/80 rounded-full px-2 py-1 shadow-sm">
<div class="w-2 h-2 rounded-full bg-secondary"></div>
<span class="font-label-sm text-label-sm text-on-surface">160g P</span>
</div>
<div class="flex items-center gap-1 bg-surface/80 rounded-full px-2 py-1 shadow-sm">
<div class="w-2 h-2 rounded-full bg-tertiary"></div>
<span class="font-label-sm text-label-sm text-on-surface">215g C</span>
</div>
<div class="flex items-center gap-1 bg-surface/80 rounded-full px-2 py-1 shadow-sm">
<div class="w-2 h-2 rounded-full bg-primary-fixed-dim"></div>
<span class="font-label-sm text-label-sm text-on-surface">71g F</span>
</div>
</div>
</div>
<!-- Context Card -->
<div class="mt-stack-lg w-full bg-surface-container-low rounded-xl p-4 border border-outline-variant/20 shadow-sm">
<div class="flex items-start gap-3">
<div class="mt-1 w-8 h-8 rounded-full bg-primary-container/20 flex items-center justify-center flex-shrink-0">
<span class="material-symbols-outlined text-primary text-sm" style="font-variation-settings: 'FILL' 1;">insights</span>
</div>
<div>
<h3 class="font-label-lg text-label-lg text-on-surface mb-1">Why this target?</h3>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">This slight caloric surplus (+150 kcal) is optimized to fuel muscle growth while minimizing excess fat accumulation, adjusting daily based on your logged workouts.</p>
</div>
</div>
</div>
</section>
<!-- Footer Actions -->
<footer class="w-full pb-8 pt-4 bg-background">
<button class="w-full py-4 rounded-full bg-tertiary text-on-tertiary font-label-lg text-label-lg shadow-md shadow-tertiary/20 hover:bg-tertiary/90 active:scale-95 transition-all flex items-center justify-center gap-2">
<span>Complete Setup</span>
<span class="material-symbols-outlined text-lg">arrow_forward</span>
</button>
<p class="font-label-sm text-label-sm text-center text-on-surface-variant mt-4 opacity-70">You can always adjust this later in settings.</p>
</footer>
</main>
</body></html>