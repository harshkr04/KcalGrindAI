<!DOCTYPE html><html class="h-full" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Vitality - Activity Level Selection</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,400;500;600;700&amp;family=Inter:wght@400;500;600&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "surface": "#f8faf9",
                      "surface-container-highest": "#e1e3e2",
                      "on-secondary-container": "#327053",
                      "on-tertiary-fixed": "#000866",
                      "primary": "#0f5238",
                      "secondary": "#2b694d",
                      "on-primary-container": "#a8e7c5",
                      "on-primary": "#ffffff",
                      "primary-fixed-dim": "#95d4b3",
                      "tertiary-fixed-dim": "#bdc2ff",
                      "on-background": "#191c1c",
                      "secondary-fixed-dim": "#94d4b1",
                      "on-secondary-fixed-variant": "#0c5136",
                      "outline-variant": "#bfc9c1",
                      "surface-container-low": "#f2f4f3",
                      "primary-fixed": "#b1f0ce",
                      "surface-bright": "#f8faf9",
                      "primary-container": "#2d6a4f",
                      "secondary-container": "#b0f1cc",
                      "surface-variant": "#e1e3e2",
                      "surface-container-high": "#e6e9e8",
                      "on-tertiary": "#ffffff",
                      "on-tertiary-container": "#d5d7ff",
                      "on-secondary-fixed": "#002113",
                      "on-primary-fixed-variant": "#0e5138",
                      "surface-container": "#eceeed",
                      "on-error": "#ffffff",
                      "on-primary-fixed": "#002114",
                      "surface-container-lowest": "#ffffff",
                      "inverse-primary": "#95d4b3",
                      "on-surface": "#191c1c",
                      "surface-tint": "#2c694e",
                      "outline": "#707973",
                      "on-error-container": "#93000a",
                      "on-secondary": "#ffffff",
                      "tertiary": "#313c9f",
                      "error": "#ba1a1a",
                      "tertiary-container": "#4a55b9",
                      "inverse-on-surface": "#eff1f0",
                      "secondary-fixed": "#b0f1cc",
                      "error-container": "#ffdad6",
                      "on-tertiary-fixed-variant": "#303b9f",
                      "surface-dim": "#d8dada",
                      "on-surface-variant": "#404943",
                      "background": "#f8faf9",
                      "tertiary-fixed": "#dfe0ff",
                      "inverse-surface": "#2e3131"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "container-padding": "20px",
                      "unit": "4px",
                      "gutter": "16px",
                      "margin-tablet": "24px",
                      "stack-md": "16px",
                      "margin-mobile": "16px",
                      "stack-sm": "8px",
                      "stack-lg": "32px"
              },
              "fontFamily": {
                      "headline-lg": [
                              "Roboto Flex"
                      ],
                      "body-lg": [
                              "Inter"
                      ],
                      "body-md": [
                              "Inter"
                      ],
                      "title-lg": [
                              "Inter"
                      ],
                      "headline-lg-mobile": [
                              "Roboto Flex"
                      ],
                      "label-sm": [
                              "Inter"
                      ],
                      "display-lg": [
                              "Roboto Flex"
                      ],
                      "label-lg": [
                              "Inter"
                      ]
              },
              "fontSize": {
                      "headline-lg": [
                              "32px",
                              {
                                      "lineHeight": "40px",
                                      "fontWeight": "600"
                              }
                      ],
                      "body-lg": [
                              "16px",
                              {
                                      "lineHeight": "24px",
                                      "letterSpacing": "0.5px",
                                      "fontWeight": "400"
                              }
                      ],
                      "body-md": [
                              "14px",
                              {
                                      "lineHeight": "20px",
                                      "fontWeight": "400"
                              }
                      ],
                      "title-lg": [
                              "22px",
                              {
                                      "lineHeight": "28px",
                                      "fontWeight": "500"
                              }
                      ],
                      "headline-lg-mobile": [
                              "28px",
                              {
                                      "lineHeight": "36px",
                                      "fontWeight": "600"
                              }
                      ],
                      "label-sm": [
                              "11px",
                              {
                                      "lineHeight": "16px",
                                      "letterSpacing": "0.5px",
                                      "fontWeight": "500"
                              }
                      ],
                      "display-lg": [
                              "57px",
                              {
                                      "lineHeight": "64px",
                                      "letterSpacing": "-0.25px",
                                      "fontWeight": "400"
                              }
                      ],
                      "label-lg": [
                              "14px",
                              {
                                      "lineHeight": "20px",
                                      "letterSpacing": "0.1px",
                                      "fontWeight": "500"
                              }
                      ]
              }
            }
          }
        }
    </script>
</head>
<body class="bg-background text-on-background h-full font-body-lg flex flex-col items-center">
<!-- Top AppBar (Linear/Transactional - Modified for Onboarding) -->
<header class="w-full flex items-center justify-between px-margin-mobile h-16 max-w-screen-md mx-auto z-50">
<button class="w-10 h-10 flex items-center justify-center rounded-full text-on-surface hover:bg-surface-variant/50 transition-colors active:scale-95">
<span class="material-symbols-outlined" data-icon="arrow_back">arrow_back</span>
</button>
<!-- Progress Indicator -->
<div class="flex items-center gap-2">
<div class="h-1.5 w-8 rounded-full bg-primary"></div>
<div class="h-1.5 w-8 rounded-full bg-primary"></div>
<div class="h-1.5 w-8 rounded-full bg-primary"></div>
<div class="h-1.5 w-8 rounded-full bg-surface-variant"></div>
<div class="h-1.5 w-8 rounded-full bg-surface-variant"></div>
<div class="h-1.5 w-8 rounded-full bg-surface-variant"></div>
<span class="ml-2 font-label-lg text-label-lg text-on-surface-variant">3/6</span>
</div>
<div class="w-10 h-10"></div> <!-- Spacer for balance -->
</header>
<main class="flex-1 w-full max-w-screen-md mx-auto px-margin-mobile py-stack-lg flex flex-col">
<div class="mb-stack-lg text-center md:text-left">
<h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-primary mb-stack-sm">How active are you?</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant">This helps us calculate your daily energy expenditure more accurately.</p>
</div>
<!-- Activity Selection List -->
<div aria-label="Activity Level" class="flex-1 flex flex-col gap-stack-md" role="radiogroup">
<!-- Option 1 -->
<label class="relative flex items-center p-4 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors cursor-pointer group border border-outline-variant/30 hover:border-outline-variant/60">
<input class="peer sr-only" name="activity_level" type="radio" value="sedentary">
<div class="absolute inset-0 rounded-xl border-2 border-transparent peer-checked:border-primary peer-checked:bg-primary-container/10 transition-all pointer-events-none"></div>
<div class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center mr-4 group-hover:scale-105 transition-transform peer-checked:bg-primary peer-checked:text-on-primary shadow-sm shadow-primary/5">
<span class="material-symbols-outlined" data-icon="chair" style="font-variation-settings: 'FILL' 1;">chair</span>
</div>
<div class="flex-1">
<div class="font-title-lg text-title-lg text-on-surface peer-checked:text-primary-fixed-variant">Sedentary</div>
<div class="font-body-md text-body-md text-on-surface-variant">Office job, mostly sitting, little to no exercise.</div>
</div>
<div class="w-6 h-6 rounded-full border-2 border-outline-variant flex items-center justify-center peer-checked:border-primary peer-checked:bg-primary ml-4">
<span class="material-symbols-outlined text-[16px] text-on-primary opacity-0 peer-checked:opacity-100 transition-opacity" data-icon="check">check</span>
</div>
</label>
<!-- Option 2 -->
<label class="relative flex items-center p-4 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors cursor-pointer group border border-outline-variant/30 hover:border-outline-variant/60">
<input class="peer sr-only" name="activity_level" type="radio" value="lightly_active">
<div class="absolute inset-0 rounded-xl border-2 border-transparent peer-checked:border-primary peer-checked:bg-primary-container/10 transition-all pointer-events-none"></div>
<div class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center mr-4 group-hover:scale-105 transition-transform peer-checked:bg-primary peer-checked:text-on-primary shadow-sm shadow-primary/5">
<span class="material-symbols-outlined" data-icon="directions_walk" style="font-variation-settings: 'FILL' 1;">directions_walk</span>
</div>
<div class="flex-1">
<div class="font-title-lg text-title-lg text-on-surface peer-checked:text-primary-fixed-variant">Lightly Active</div>
<div class="font-body-md text-body-md text-on-surface-variant">Light exercise or sports 1-3 days a week.</div>
</div>
<div class="w-6 h-6 rounded-full border-2 border-outline-variant flex items-center justify-center peer-checked:border-primary peer-checked:bg-primary ml-4">
<span class="material-symbols-outlined text-[16px] text-on-primary opacity-0 peer-checked:opacity-100 transition-opacity" data-icon="check">check</span>
</div>
</label>
<!-- Option 3 (Pre-selected for demonstration) -->
<label class="relative flex items-center p-4 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors cursor-pointer group border border-outline-variant/30 hover:border-outline-variant/60">
<input checked="" class="peer sr-only" name="activity_level" type="radio" value="moderately_active">
<div class="absolute inset-0 rounded-xl border-2 border-transparent peer-checked:border-primary peer-checked:bg-primary-container/10 transition-all pointer-events-none"></div>
<div class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center mr-4 group-hover:scale-105 transition-transform peer-checked:bg-primary peer-checked:text-on-primary shadow-sm shadow-primary/5">
<span class="material-symbols-outlined" data-icon="fitness_center" style="font-variation-settings: 'FILL' 1;">fitness_center</span>
</div>
<div class="flex-1">
<div class="font-title-lg text-title-lg text-on-surface peer-checked:text-primary-fixed-variant">Moderately Active</div>
<div class="font-body-md text-body-md text-on-surface-variant">Moderate exercise or sports 3-5 days a week.</div>
</div>
<div class="w-6 h-6 rounded-full border-2 border-outline-variant flex items-center justify-center peer-checked:border-primary peer-checked:bg-primary ml-4">
<span class="material-symbols-outlined text-[16px] text-on-primary opacity-0 peer-checked:opacity-100 transition-opacity" data-icon="check">check</span>
</div>
</label>
<!-- Option 4 -->
<label class="relative flex items-center p-4 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors cursor-pointer group border border-outline-variant/30 hover:border-outline-variant/60">
<input class="peer sr-only" name="activity_level" type="radio" value="very_active">
<div class="absolute inset-0 rounded-xl border-2 border-transparent peer-checked:border-primary peer-checked:bg-primary-container/10 transition-all pointer-events-none"></div>
<div class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center mr-4 group-hover:scale-105 transition-transform peer-checked:bg-primary peer-checked:text-on-primary shadow-sm shadow-primary/5">
<span class="material-symbols-outlined" data-icon="directions_run" style="font-variation-settings: 'FILL' 1;">directions_run</span>
</div>
<div class="flex-1">
<div class="font-title-lg text-title-lg text-on-surface peer-checked:text-primary-fixed-variant">Very Active</div>
<div class="font-body-md text-body-md text-on-surface-variant">Hard exercise, sports, or physical job (Athlete).</div>
</div>
<div class="w-6 h-6 rounded-full border-2 border-outline-variant flex items-center justify-center peer-checked:border-primary peer-checked:bg-primary ml-4">
<span class="material-symbols-outlined text-[16px] text-on-primary opacity-0 peer-checked:opacity-100 transition-opacity" data-icon="check">check</span>
</div>
</label>
</div>
<!-- Sticky Bottom Action -->
<div class="mt-auto pt-stack-lg pb-safe">
<button class="w-full py-4 rounded-full bg-tertiary text-on-tertiary font-label-lg text-label-lg flex items-center justify-center gap-2 hover:bg-tertiary/90 active:scale-95 transition-all shadow-md shadow-tertiary/20">
                Continue
                <span class="material-symbols-outlined text-[20px]" data-icon="arrow_forward">arrow_forward</span>
</button>
</div>
</main>
<!-- Suppressed TopAppBar and BottomNavBar as this is a linear onboarding flow -->
</body></html>