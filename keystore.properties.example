# ==============================================================================
# Kcal Grind AI — Android Release Keystore Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `keystore.properties` in your root project directory:
#    cp keystore.properties.example keystore.properties
# 2. Fill in your actual production keystore credentials.
# 3. NEVER commit `keystore.properties` or your `.jks`/`.keystore` file to git!
# ==============================================================================

storeFile=/path/to/kcalgrindai-release-key.jks
storePassword=your-strong-store-password
keyAlias=kcalgrindai-release-alias
keyPassword=your-strong-key-password
